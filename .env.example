# Environment Variables for MYZL
# Copy this file to .env and modify as needed

# Base URL for the application
# Use '/myzl/' for GitHub Pages deployment
# Use '/' for root-hosted deployment
# Leave empty or comment out for local development (defaults to '/')
# VITE_BASE_URL=/

# Enable Cloudflare Vite plugin
# Set to 'true' to use Cloudflare dev runtime during development
# Default: disabled (uses pure Vite)
# Usage: npm run dev:cf or set manually
# VITE_ENABLE_CLOUDFLARE=true

# CloudBase Deployment (CI/CD only)
# Configure in GitHub Secrets, not in .env file
# See docs/cloudbase-deployment.md for details
# TCB_SECRET_ID: Tencent Cloud SecretId
# TCB_SECRET_KEY: Tencent Cloud SecretKey
# TCB_ENV_ID: CloudBase Environment ID
